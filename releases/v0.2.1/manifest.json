{
  "manifest_version": 3,
  "name": "Verafy: Truth Check",
  "version": "0.2.0",
  "description": "Read any page with a truth filter: every claim highlighted and checked, plus cliff notes and missing perspectives.",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting", "contextMenus", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open Verafy",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
